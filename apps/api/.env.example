# ============================================================
# apps/api — バックエンド環境変数
# 使い方: cp .env.example .env
# 秘密情報は .env にのみ書き、Git にコミットしないこと
# ============================================================

# サーバー
PORT=3000
# CORS 許可オリジン(カンマ区切り)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL(ルート .env の POSTGRES_* と一致させる)
DATABASE_URL="postgresql://pokemon:pokemon_local_dev@localhost:5432/pokemon_champions?schema=public"

# Redis(任意。未設定・接続不可でもAPIは起動し、Redis利用機能はフォールバックする)
REDIS_URL="redis://localhost:6379"
# 対戦候補レスポンスのRedisキャッシュTTL秒数(任意、正の整数、未設定・不正時は30秒)
BATTLE_CANDIDATES_CACHE_TTL_SECONDS=30
# 観測入力APIのユーザー単位レート制限(任意、正の整数、未設定・不正時は60req/60秒)
BATTLE_RATE_LIMIT=60
BATTLE_RATE_LIMIT_WINDOW_SECONDS=60
# 対戦セッション自動アーカイブ(任意、正の整数秒、未設定・不正時は90日/90日/1時間)
BATTLE_ACTIVE_ARCHIVE_AFTER_SECONDS=7776000
BATTLE_ENDED_ARCHIVE_AFTER_SECONDS=7776000
BATTLE_ARCHIVE_INTERVAL_SECONDS=3600

# JWTアクセストークン(AUTH-002。openssl rand -base64 32 等で生成すること)
JWT_ACCESS_SECRET=changeme-generate-a-real-secret
JWT_ACCESS_EXPIRES_IN=15m

# opaqueリフレッシュトークンのHMAC鍵(AUTH-003。アクセストークン鍵とは別に生成すること)
JWT_REFRESH_SECRET=changeme-generate-a-real-secret
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic API(APIキーとmodelが有効な場合だけ利用。timeout未設定は5000ms、不正設定はTemplateへフォールバック)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_TIMEOUT_MS=5000
# LLM説明RedisキャッシュTTL秒数(未設定は86400、許可範囲60〜604800。不正時は非同期生成を無効化)
# LLM_EXPLANATION_CACHE_TTL_SECONDS=86400
